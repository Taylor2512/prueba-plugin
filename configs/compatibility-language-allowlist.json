{
  "version": 1,
  "contentPatterns": [
    {
      "pattern": "pdfjs-dist/legacy/",
      "reason": "Official third-party import path controlled by pdfjs-dist",
      "removeAfter": null
    },
    {
      "pattern": "__commentAnchors",
      "reason": "Persisted V1 snapshot key; allowed only in migration and tests",
      "removeAfter": "next-major-after-migration-window"
    }
  ],
  "pathExclusions": [
    "node_modules/**",
    "dist/**",
    "coverage/**",
    "reports/**",
    ".tailwind-migration-backups/**",
    "src/sisad-pdfme/pdf-lib/**"
  ],
  "activeSourceRoots": [
    "src/sisad-pdfme",
    "tests",
    "docs",
    ".ai",
    ".agents",
    ".github",
    "scripts"
  ]
}
