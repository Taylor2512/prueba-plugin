{
  "path": ["src", "server", "scripts"],
  "mode": "mild",
  "minLines": 6,
  "minTokens": 50,
  "reporters": ["console", "json"],
  "output": "reports/jscpd-owned",
  "ignore": [
    "**/node_modules/**",
    "**/dist/**",
    "**/coverage/**",
    "**/.tailwind-migration-backups/**",
    "src/sisad-pdfme/pdf-lib/**",
    "**/reports/**",
    "**/*documentacion-consolidada*.md",
    "**/documentacion-common-sisad-pdfme.md"
  ]
}
