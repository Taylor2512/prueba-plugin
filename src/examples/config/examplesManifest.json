      "description": "Puerta de entrada a todos los ejemplos.",
      "shell": "documentation",
      "page": "catalog"
    },
    {
      "id": "designer-single-user",
      "title": "Designer: un usuario",
      "description": "Un solo usuario con todas las familias de schema.",
      "shell": "immersive",
      "instanceId": "designer-single-user",
      "viewportName": "designer-single-user",
      "modeBadge": "designer",
      "template": {
        "builder": "showcaseTemplate",
        "options": {
          "familySource": "all"
        }
      },
      "infoPanels": [
        {
          "key": "summary",
          "title": "Resumen",
          "description": "Métricas del template actual",
          "type": "metrics",
          "metrics": [
            {
              "label": "Páginas",
              "path": "template.schemas.length"
            },
            {
              "label": "Schemas",
              "path": "template.schemas.flat().length"
            },
            {
              "label": "Perfil",
              "value": "designer-single-user"
            },
            {
              "label": "Guardado",
              "path": "savedAt",
              "fallback": "nunca"
            }
          ]
        },
        {
          "key": "controller",
          "title": "Controlador",
          "description": "API imperativa pública",
          "type": "controller"
        },
        {
          "key": "events",
          "title": "Eventos",
          "description": "Callbacks del wrapper",
          "type": "events"
        },
        {
          "key": "families",
          "title": "Familias incluidas",
          "description": "Registry de tipos del runtime",
          "type": "families"
        }
      ],
      "handlers": {
        "onTemplateChange": {
          "type": "setTemplate",
          "record": true
        }
      },
      "mode": "designer"
    },
    {
      "id": "designer-multi-user",
      "title": "Designer · flujo multiusuario",
      "description": "Colaboración con varios usuarios y cambio de actor activo.",
      "shell": "immersive",
      "instanceId": "designer-multi-user",
      "viewportName": "designer-multi-user",
      "modeBadge": "colaboración",
      "template": {
        "builder": "multiUserShowcase",
        "options": {
          "familySource": "multiUser"
        }
      },
      "state": {
        "activeRecipientId": "initializer",
        "assignments": 0
      },
      "actions": {
        "recipientSelect": {
          "type": "select",
          "label": "Recipient activo"
        }
      },
      "infoPanels": [
        {
          "key": "summary",
          "title": "Participantes",
          "description": "Estado de la colaboración",
          "type": "metrics",
          "metrics": [
            {
              "label": "Participante activo",
              "path": "activeRecipient.name"
            },
            {
              "label": "Total participantes",
              "value": 3
            },
            {
              "label": "Asignaciones",
              "path": "assignments"
            },
            {
              "label": "Documentos",
              "value": 2
            }
          ]
        },
        {
          "key": "controller",
          "title": "Controlador",
          "description": "API imperativa pública",
          "type": "controller"
        },
        {
          "key": "events",
          "title": "Eventos",
          "description": "Callbacks de la colaboración",
          "type": "events"
        }
      ],
      "handlers": {
        "onTemplateChange": {
          "type": "setTemplate",
          "record": true
        },
        "onActiveRecipientChange": {
          "type": "setState",
          "field": "activeRecipientId",
          "valuePath": "id",
          "record": true
        },
        "onAssignmentChange": {
          "type": "increment",
          "field": "assignments",
          "record": true
        }
      },
      "mode": "designer",
      "collaboration": true
    },
    {
      "id": "runtime-form",
