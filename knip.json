{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/main.{js,jsx,ts,tsx}!",
    "scripts/quality/**/*.{js,mjs,cjs}",
    "tests/**/*.spec.{js,jsx,ts,tsx}",
    "tests/**/*.test.{js,jsx,ts,tsx}",
    "src/sisad-pdfme/index.ts!",
    "src/sisad-pdfme/common/index.ts!",
    "src/sisad-pdfme/contracts/index.ts!",
    "src/sisad-pdfme/config/index.ts!",
    "src/sisad-pdfme/comments/index.ts!",
    "src/sisad-pdfme/assignments/index.ts!",
    "src/sisad-pdfme/collaboration/index.ts!",
    "src/sisad-pdfme/converter/index.ts!",
    "src/sisad-pdfme/documents/index.ts!",
    "src/sisad-pdfme/devtools/index.ts!",
    "src/sisad-pdfme/generator/index.ts!",
    "src/sisad-pdfme/integration/index.ts!",
    "src/sisad-pdfme/react/index.ts!",
    "src/sisad-pdfme/schemas/index.ts!",
    "src/sisad-pdfme/ui/index.ts!"
  ],
  "project": [
    "src/**/*.{js,jsx,ts,tsx}!",
    "scripts/**/*.{js,mjs,cjs}",
    "tests/**/*.{js,jsx,ts,tsx}",
    "!src/generated/**",
    "!dist/**",
    "!coverage/**",
    "!reports/**",
    "!playwright-report/**",
    "!test-results/**"
  ],
  "includeEntryExports": false,
  "rules": {
    "files": "error",
    "dependencies": "error",
    "devDependencies": "error",
    "unlisted": "error",
    "binaries": "error",
    "unresolved": "error",
    "exports": "error",
    "types": "warn",
    "duplicates": "warn",
    "cycles": "warn"
  }
}
