{
  "README": "Configuración global de los ejemplos SISAD PDFME. `base` activa TODAS las funcionalidades del componente; `profiles` solo declara la diferencia de cada ruta. Para encender o apagar algo, edita este archivo: no hay configuración embebida en las páginas. La forma de `base` y de cada perfil es SisadPdfmeGlobalConfig (ver docs/08-api-reference/04-configuracion-completa.md). IMPORTANTE: este archivo debe permanecer JSON puro. El componente clona la config con structuredClone, así que una función en `events` rompe el montaje; por eso los eventos se declaran como \"host\" y los callbacks reales viajan como props del wrapper. `ui.density` NO se declara: es alias legacy de `theme.density` y declarar ambos produce el aviso config-canonical-wins.",
  "base": {
    "configVersion": 2,
    "app": {
      "id": "sisad-pdfme-examples",
      "name": "SISAD PDFME · ejemplos",
      "locale": "es",
      "environment": "development"
    },
    "runtime": {
      "mode": "designer",
      "readonly": false,
      "isolateDomEvents": true,
      "preserveSelectionOnModalClose": true
    },
    "theme": {
      "strategy": "tailwind",
      "density": "comfortable"
    },
    "canvas": {
      "enabled": true,
      "selecto": true,
      "moveable": true,
      "snapLines": true,
      "guides": true,
      "emptyClickClearsSelection": true,
      "multiSelect": true,
      "platformSelection": "auto",
      "suspendWhenModalOpen": true,
      "resetInteractionOnModalClose": true
    },
    "schemas": {
      "autoAttachIdentity": true,
      "validateUniqueNames": true,
      "defaultOwnerStrategy": "active-recipient"
    },
    "sidebars": {
      "left": {
        "enabled": true,
        "defaultOpen": true,
        "catalogLayout": "grid",
        "allowCustomFields": true
      },
      "right": {
        "enabled": true,
        "defaultOpen": true,
        "defaultPanel": "detail",
        "panels": [
          "fields",
          "detail",
          "comments",
          "documents"
        ],
        "density": "comfortable",
        "showCollapsedButton": true
      }
    },
    "recipients": {
      "enabled": true,
      "activeRecipientId": null,
      "allowUnassigned": true,
      "allowShared": true,
      "allowMultipleOwners": false,
      "defaultOwnerStrategy": "active-recipient",
      "colorStrategy": "recipient",
      "missingRecipientBehavior": "keep-id"
    },
    "collaboration": {
      "enabled": false,
      "isGlobalView": false,
      "canEditStructure": true,
      "ownerColorStrategy": "recipient"
    },
    "assignment": {
      "enabled": true,
      "allowSingle": true,
      "allowBulk": true,
      "preserveLockState": true,
      "showCurrentRecipient": true,
      "searchable": true,
      "closeOnCancel": true,
      "closeOnConfirm": true
    },
    "documents": {
      "mode": "single",
      "preserveDocumentSchemaRouting": true,
      "activeDocumentStrategy": "internal"
    },
    "signatures": {
      "enabled": true,
      "defaultMode": "draw",
      "providers": [
        {
          "key": "draw",
          "label": "Trazo manuscrito",
          "description": "Firma dibujada en el propio documento.",
          "capabilities": {
            "draw": true,
            "image": false,
            "certificate": false
          }
        },
        {
          "key": "image",
          "label": "Imagen cargada",
          "description": "Firma a partir de una imagen del participante.",
          "capabilities": {
            "draw": false,
            "image": true,
            "certificate": false
          }
        },
        {
          "key": "p12",
          "label": "Certificado P12",
          "description": "Firma criptográfica con certificado del participante.",
          "capabilities": {
            "draw": false,
            "image": false,
            "certificate": true
          },
          "metadata": {
            "requiresPin": true
          }
        }
      ]
    },
    "persistence": {
      "mode": "none",
      "autosave": false,
      "serializeSnapshot": true
    },
    "debug": {
      "enabled": false,
      "showTechnicalInspector": true,
      "logEvents": false
    },
    "visibility": {
      "shell": {
        "header": true,
        "footer": true,
        "statusBar": true,
        "resultsPanel": true,
        "debugPanel": false
      },
      "canvas": {
        "toolbar": true,
        "floatingToolbar": true,
        "contextMenu": true,
        "pageNavigator": true,
        "zoomControls": true,
        "grid": true,
        "rulers": true,
        "guides": true,
        "snapLines": true,
        "selectionBox": true,
        "ownerBadges": true,
        "requiredMarkers": true,
        "lockBadges": true
      },
      "sidebars": {
        "left": {
          "visible": true,
          "collapseButton": true,
          "search": true,
          "tabs": true,
          "catalog": true,
          "customFields": true,
          "favorites": true,
          "recent": true,
          "recipients": true
        },
        "right": {
          "visible": true,
          "collapseButton": true,
          "tabs": true,
          "contextHeader": true,
          "panels": {
            "fields": true,
            "detail": true,
            "comments": true,
            "documents": true
          }
        }
      },
      "actions": {
        "reassign": true,
        "rename": true,
        "duplicate": true,
        "delete": true,
        "copy": true,
        "paste": true,
        "lock": true,
        "unlock": true,
        "hide": true,
        "show": true,
        "align": true,
        "distribute": true,
        "matchSize": true
      },
      "inspector": {
        "visible": true,
        "showEmptySections": false,
        "showAdvanced": true,
        "showTechnical": true,
        "showCollaboration": true,
        "showComments": true,
        "sections": {
          "identity": true,
          "options": true,
          "validation": true,
          "behavior": true,
          "box": true,
          "appearance": true,
          "help": true,
          "dataBindings": true,
          "collaboration": true,
          "comments": true,
          "advanced": true
        }
      },
      "modals": {
        "assignment": true,
        "schemaDropSetup": true,
        "customField": true,
        "comments": true,
        "shortcutHelp": true
      },
      "runtime": {
        "fieldChrome": true,
        "readonlyChrome": true,
        "ownerColor": true,
        "recipientFilter": true
      }
    },
    "ui": {
      "visualPreset": "classic-designer",
      "layoutPreset": "three-panel",
      "gap": "0.5rem",
      "padding": "0.5rem",
      "baseWidth": "100%",
      "baseHeight": "100%"
    },
    "events": {
      "onReady": "host",
      "onChange": "host",
      "onSave": "host",
      "onError": "host",
      "onSelectionChange": "host",
      "onRecipientsChange": "host",
      "onActiveRecipientChange": "host",
      "onAssignmentChange": "host",
      "onDocumentChange": "host",
      "onSignatureRequest": "host"
    }
  },
  "profiles": {
    "designer-single-user": {
      "collaboration": {
        "enabled": false,
        "isGlobalView": false
      },
      "documents": {
        "mode": "single"
      },
      "sidebars": {
        "right": {
          "defaultPanel": "detail"
        }
      }
    },
    "designer-multi-user": {
      "collaboration": {
        "enabled": true,
        "isGlobalView": false
      },
      "documents": {
        "mode": "multi"
      },
      "sidebars": {
        "right": {
          "defaultPanel": "comments"
        }
      }
    },
    "runtime-form": {
      "runtime": {
        "mode": "form"
      },
      "collaboration": {
        "enabled": false
      },
      "sidebars": {
        "right": {
          "defaultPanel": "detail"
        }
      }
    },
    "runtime-viewer": {
      "runtime": {
        "mode": "viewer",
        "readonly": true
      },
      "collaboration": {
        "enabled": false,
        "isGlobalView": true
      },
      "sidebars": {
        "right": {
          "defaultPanel": "fields"
        }
      }
    },
    "schema-family": {
      "collaboration": {
        "enabled": false
      },
      "sidebars": {
        "right": {
          "defaultPanel": "detail"
        }
      }
    }
  }
}
