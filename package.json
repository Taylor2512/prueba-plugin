{
  "name": "sisadbeta",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:4173": "VITE_LOCAL_PROXY_ENABLED=true VITE_ENABLE_PROXY=true VITE_PORT=4173 vite --host --port 4173",
    "build": "NODE_OPTIONS=--max-old-space-size=81922 vite build",
    "build:mem": "NODE_OPTIONS=--max-old-space-size=81922 vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "test": "vitest",
    "test:e2e": "npx playwright test",
    "build:watch": "vite build --watch",
    "preview:prod": "vite preview --host 0.0.0.0 --port 5173",
    "quality:dead-code": "knip --cache",
    "quality:dead-code:production": "knip --production --cache",
    "quality:dead-files": "knip --files",
    "quality:dead-exports": "knip --exports",
    "quality:dead-dependencies": "knip --dependencies",
    "quality:cycles": "knip --cycles",
    "quality:dead-code:audit": "knip",
    "quality:dead-code:fix:unsafe": "knip --fix",
    "quality:dead-code:ci": "knip --production",
    "quality:template-contracts": "node scripts/quality/validate-form-template-runtime-references.mjs",
    "watch": "npm run build && concurrently -k \"npm:build:watch\" \"npm:preview:prod\"",
    "quality:large-files": "node scripts/quality/list-large-files.js --max-lines=700",
    "quality:direct-config-readers": "node scripts/quality/check-direct-config-readers.mjs",
    "quality:source-language-boundary": "node scripts/quality/check-source-language-boundary.mjs",
    "quality:compatibility-language": "node scripts/quality/audit-compatibility-language.mjs",
    "quality:compatibility-language:strict": "node scripts/quality/audit-compatibility-language.mjs --strict",
    "quality:example-style-boundary": "node scripts/quality/check-example-style-boundary.mjs",
    "quality:duplicate-functions": "node scripts/quality/find-symbol-name-duplicates.js --mode=all",
    "quality:wrapper-components": "node scripts/quality/find-wrapper-components.js",
    "quality:duplicate-hooks": "node scripts/quality/find-symbol-name-duplicates.js --mode=hooks",
    "quality:duplicate-css": "node scripts/quality/find-css-duplicates.js",
    "quality:file-size-range": "node scripts/quality/check-js-jsx-file-size-range.js --root=src --min-lines=300 --max-lines=700",
    "quality:inspect-signing-har": "node scripts/quality/inspect-signing-har.js",
    "quality:duplicates": "jscpd src server scripts",
    "quality:duplicates:strict": "jscpd src server scripts --mode mild --min-lines 6 --min-tokens 50",
    "quality:duplicates:owned": "jscpd src server scripts --config configs/jscpd-owned.json",
    "quality:duplicates:docs": "jscpd .ai .agents .github docs --config configs/jscpd-docs.json",
    "quality:duplicates:profiles": "npm run quality:duplicates:owned && npm run quality:duplicates:vendor && npm run quality:duplicates:docs",
    "quality:duplicates:ci": "jscpd src server scripts --threshold 8 --reporters console,json,sarif --output reports/jscpd --no-tips",
    "quality:custom": "npm run quality:duplicate-functions && npm run quality:wrapper-components && npm run quality:duplicate-hooks && npm run quality:duplicate-css",
    "quality:architecture": "npm run quality:large-files && npm run quality:file-size-range && npm run quality:custom",
    "quality": "npm run lint && npm run quality:direct-config-readers && npm run quality:source-language-boundary && npm run quality:dead-code:ci && npm run quality:duplicates:ci && npm run quality:architecture",
    "quality:no-inline-domain-copy": "vitest run src/core/engines/validationEngine/__tests__/validationMessages.static.test.js src/domain/documents/__tests__/documentCopyConstants.static.test.js src/modules/forms/runtime/__tests__/formsWorkflowConstants.static.test.js src/modules/forms/hooks/signing-review/__tests__/signingReviewMessages.static.test.js src/modules/forms/hooks/liveness/__tests__/livenessMessages.static.test.js src/modules/forms/hooks/__tests__/signingDocumentPreparationMessages.static.test.js src/store/slices/__tests__/storeMessages.static.test.js src/domain/forms/__tests__/formsDomainMessages.static.test.js src/shared/components/attachments/__tests__/attachmentsCopy.static.test.js src/modules/external-flow/pages/__tests__/externalFlowCopy.static.test.js src/domain/forms/adapters/__tests__/AdapterMessages.static.test.js",
    "maintenance:add-select-label-paths": "node scripts/add-labelpath-to-selects.mjs",
    "quality:validation-samples": "node scripts/validate-samples.mjs",
    "maintenance:sync-scrum-views": "node scripts/ai/sync-scrum-views.mjs",
    "tools:doctor": "node scripts/project-tools.mjs doctor .",
    "docs:scan": "node scripts/project-tools.mjs scan .",
    "docs:sanitize": "node scripts/project-tools.mjs sanitize .",
    "docs:sanitize:apply": "node scripts/project-tools.mjs sanitize . --apply",
    "docs:index": "node scripts/project-tools.mjs index .",
    "docs:links": "node scripts/project-tools.mjs links . --apply",
    "docs:duplicates": "node scripts/project-tools.mjs duplicates .",
    "docs:validate": "node scripts/project-tools.mjs validate .",
    "architecture:import": "node scripts/project-tools.mjs import .",
    "architecture:all": "node scripts/project-tools.mjs all . --apply"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.0.8",
    "@dnd-kit/sortable": "^10.0.0",
    "@pdf-lib/standard-fonts": "^1.0.0",
    "@pdf-lib/upng": "^1.0.1",
    "@scena/react-guides": "^0.28.2",
    "acorn": "^8.15.0",
    "air-datepicker": "^3.6.0",
    "antd": "^5.27.4",
    "bwip-js": "^4.8.0",
    "color": "^4.2.3",
    "date-fns": "^2.30.0",
    "dompurify": "^3.3.1",
    "fontkit": "^2.0.2",
    "form-render": "^2.5.5",
    "hotkeys-js": "^3.13.15",
    "lucide-react": "^0.563.0",
    "node-html-better-parser": "^1.5.8",
    "pako": "^2.1.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "2.16.105",
    "prop-types": "^15.8.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-moveable": "^0.56.0",
    "react-router-dom": "^6.4.3",
    "react-selecto": "^1.12.0",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.30",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^14.0.0",
    "@testing-library/user-event": "^14.5.0",
    "@types/node": "^25.3.0",
    "@types/react": "^18.0.22",
    "@types/react-dom": "^18.0.7",
    "@typescript-eslint/eslint-plugin": "^8.56.0",
    "@typescript-eslint/parser": "^8.56.0",
    "@vitejs/plugin-react": "^2.2.0",
    "autoprefixer": "^10.5.2",
    "concurrently": "^10.0.3",
    "eslint": "^9.39.2",
    "eslint-import-resolver-typescript": "^3.5.3",
    "eslint-plugin-import": "^2.27.5",
    "eslint-plugin-jsx-a11y": "^6.7.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "jscpd": "^5.0.12",
    "jsdom": "^22.1.0",
    "knip": "^6.29.0",
    "playwright": "^1.58.2",
    "postcss": "^8.5.16",
    "tailwindcss": "^3.4.19",
    "typescript": "^6.0.3",
    "vite": "^3.2.5",
    "vitest": "^0.34.0"
  },
  "overrides": {
    "@sisad-pdfme/converter": {
      "pdfjs-dist": "2.16.105"
    }
  }
}
