{
  "threshold": 8,
  "reporters": [
    "console",
    "json",
    "html"
  ],
  "output": "reports/jscpd",
  "minLines": 6,
  "minTokens": 50,
  "mode": "mild",
  "ignore": [
    "**/node_modules/**",
    "**/dist/**",
    "**/coverage/**",
    "**/test-results/**",
    "**/.tailwind-migration-backups/**",
    "**/reports/**",
    "src/sisad-pdfme/pdf-lib/**",
    "**/*.md"
  ]
}
