{"id": "ACT-001", "name": "insert-schema", "visibleWhen": "schema type available and catalog surface visible", "enabledWhen": "access.canCreate && target page valid", "command": "InsertSchemaCommand", "events": ["schema.added", "template.changed"]}
{"id": "ACT-002", "name": "reassign-recipient", "visibleWhen": "assignableRecipientCount > 1 && selectionCount > 0", "enabledWhen": "canEditStructure && selected schemas assignable", "command": "ReassignSchemasCommand", "events": ["schema.owner.changed", "assignment.changed"]}
{"id": "ACT-003", "name": "rename-schema", "visibleWhen": "selectionCount == 1", "enabledWhen": "access.canEditIdentity", "command": "RenameSchemaCommand", "events": ["schema.updated"]}
{"id": "ACT-004", "name": "delete-schema", "visibleWhen": "selectionCount > 0", "enabledWhen": "all selected deletable", "command": "DeleteSchemasCommand", "events": ["schema.removed", "selection.changed"]}
{"id": "ACT-005", "name": "toggle-grid", "visibleWhen": "feature grid registered", "enabledWhen": "runtime editable", "command": "ToggleViewFeatureCommand", "events": ["view-feature.changed"]}
