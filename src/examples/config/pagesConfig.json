{
  "pages": {
    "designer-single-user": {
      "title": "Designer · una persona, todas las familias",
      "modeBadge": "designer",
      "viewportName": "designer-single-user",
      "instanceId": "designer-single-user",
      "path": "/designer/single-user",
      "template": {
        "builder": "showcaseTemplate",
        "options": {
          "familySource": "all"
        }
      },
      "infoPanels": [
        {
          "key": "summary",
          "title": "Resumen",
          "description": "Métricas del template actual",
          "type": "metrics",
          "metrics": [
            { "label": "Páginas", "path": "template.schemas.length" },
            { "label": "Schemas", "path": "template.schemas.flat().length" },
            { "label": "Perfil", "value": "designer-single-user" },
            { "label": "Guardado", "path": "savedAt", "fallback": "nunca" }
          ]
        },
        {
          "key": "controller",
          "title": "Controlador",
          "description": "API imperativa pública",
          "type": "controller"
        },
        {
          "key": "events",
          "title": "Eventos",
          "description": "Callbacks del wrapper",
          "type": "events"
        },
        {
          "key": "families",
          "title": "Familias incluidas",
          "description": "Registry de tipos del runtime",
          "type": "families"
        }
      ],
      "handlers": {
        "onTemplateChange": { "type": "setTemplate", "record": true }
      }
    },
    "designer-multi-user": {
      "title": "Designer · flujo multiusuario",
      "modeBadge": "colaboración",
      "viewportName": "designer-multi-user",
      "instanceId": "designer-multi-user",
      "path": "/designer/multi-user",
      "template": {
        "builder": "multiUserShowcase",
        "options": {
          "familySource": "multiUser"
        }
      },
      "state": {
        "activeRecipientId": "initializer",
        "assignments": 0
      },
      "actions": {
        "recipientSelect": { "type": "select", "label": "Recipient activo" }
      },
      "infoPanels": [
        {
          "key": "summary",
          "title": "Participantes",
          "description": "Estado de la colaboración",
          "type": "metrics",
          "metrics": [
            { "label": "Participante activo", "path": "state.activeRecipient.name" },
            { "label": "Total participantes", "value": 3 },
            { "label": "Asignaciones", "path": "state.assignments" },
            { "label": "Documentos", "value": 2 }
          ]
        },
        {
          "key": "controller",
          "title": "Controlador",
          "description": "API imperativa pública",
          "type": "controller"
        },
        {
          "key": "events",
          "title": "Eventos",
          "description": "Callbacks de la colaboración",
          "type": "events"
        }
      ],
      "handlers": {
        "onTemplateChange": { "type": "setTemplate", "record": true },
        "onActiveRecipientChange": { "type": "setState", "record": true },
        "onAssignmentChange": { "type": "increment", "field": "assignments", "record": true }
      }
    },
    "runtime-form": {
      "title": "Runtime · Form para captura de datos",
      "modeBadge": "form",
      "viewportName": "runtime-form",
      "instanceId": "runtime-form",
      "path": "/runtime/form",
      "template": {
        "builder": "showcaseTemplate",
        "options": {
          "familyKeys": ["text", "choice", "boolean", "dateTime", "signature"]
        }
      },
      "state": {
        "lastInput": ""
      },
      "infoPanels": [
        {
          "key": "capture",
          "title": "Captura de datos",
          "description": "Último campo modificado",
          "type": "metrics",
          "metrics": [
            { "label": "Última entrada", "path": "state.lastInput", "fallback": "sin cambios" }
          ]
        },
        {
          "key": "events",
          "title": "Eventos",
          "description": "Cambios de input",
          "type": "events"
        }
      ],
      "handlers": {
        "onInputChange": { "type": "custom", "record": true }
      }
    },
    "runtime-viewer": {
      "title": "Runtime · Viewer de solo lectura",
      "modeBadge": "viewer",
      "viewportName": "runtime-viewer",
      "instanceId": "runtime-viewer",
      "path": "/runtime/viewer",
      "template": {
        "builder": "showcaseTemplate",
        "options": {
          "familyKeys": ["text", "table", "media", "barcode", "shape"]
        }
      },
      "infoPanels": [
        {
          "key": "preview",
          "title": "Cobertura de lectura",
          "description": "Tipos de campos soportados",
          "type": "metrics",
          "metrics": [
            { "label": "Modo", "value": "Viewer" },
            { "label": "Editable", "value": "No" }
          ]
        },
        {
          "key": "events",
          "title": "Eventos",
          "description": "Acciones del viewer",
          "type": "events"
        }
      ]
    }
  }
}
